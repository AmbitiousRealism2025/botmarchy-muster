{
  "schemaVersion": 1,
  "id": "dev.botmarchy.muster",
  "name": "Botmarchy Muster",
  "version": "0.2.1",
  "author": "AmbitiousRealism",
  "description": "Your Botmarchy bot court at a glance: roster status in the bar, hover for per-bot activity, click for the roster window.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Botmarchy Muster",
    "description": "Roster roll call for a self-hosted Botmarchy gateway",
    "category": "Agents",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "intervalSec": 10,
      "sshTarget": ""
    },
    "schema": [
      {
        "key": "intervalSec",
        "type": "int",
        "label": "Refresh interval (seconds)"
      },
      {
        "key": "sshTarget",
        "type": "string",
        "label": "Gateway SSH target (user@host)"
      }
    ]
  }
}
